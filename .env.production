# VITE_API_BASE_URL TIDAK LAGI dipakai langsung oleh axios client produksi
# (src/api/index.js sekarang pakai baseURL relatif "/api" — Flask omni-invest
# serve /api/* DAN dist/ dari proses yang sama di port 4500, jadi path
# relatif otomatis ikut host:port yang dipakai browser untuk buka
# halamannya, apa pun IP/jaringan viewer-nya). Root cause awal: baseURL
# di-hardcode ke satu IP (192.168.192.81, LAN lokal STB server) yang tidak
# ke-route dari STB "penampil" (device kedua, cuma terhubung lewat ZeroTier
# — `ip route`-nya cuma punya rute ke 10.10.20.0/24 & 10.147.20.0/24 via
# ztmosde6hc), sehingga /api/report selalu timeout dari device itu meski
# device yang sama berhasil memuat halamannya sendiri.
# Var ini masih dipertahankan HANYA sebagai target proxy dev server
# (`npm run dev`, lihat vite.config.js) — tidak berefek ke build produksi.
VITE_API_BASE_URL=http://10.147.20.103:4500/api

# Zakanet-backend-monitoring TETAP backend terpisah (server lain, port 3000)
# — bukan bagian dari Flask omni-invest, jadi ini TETAP harus absolut dan
# TETAP bergantung ke reachability jaringan tiap viewer ke 10.147.20.103.
VITE_ZAKANET_API_BASE_URL=http://10.147.20.103:3000/api

# API key gratis CARTO untuk basemap peta ZakanetMapCore (dark_all) — daftar
# di carto.com/basemaps/apikey/ (tanpa antrean approval, kuota 5 juta tile
# request/bulan). Tanpa ini, tile peta cuma tampil watermark
# "API KEY REQUIRED" (lihat src/components/monitor/ZakanetMapCore.vue).
VITE_CARTO_API_KEY=cb1_43g9_1_a93a53651ab3af4cf8113c1d
